// HMS — the HOSPITAL schema.
//
// One database shaped like this per hospital. Nothing here has a tenant column,
// and that is the point: separation is the database boundary, not a WHERE
// clause someone has to remember.
//
// Milestone 03 adds the first models. Migration: add_auth.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// No `url` here on purpose. The connection string is supplied at runtime by the
// driver adapter, which is what makes one client per hospital possible.
datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  name         String?

  // PLACEHOLDER. Two string roles is what milestone 01 inherited and it is not
  // what a hospital needs — receptionists, triage nurses, doctors, lab
  // scientists, pharmacists, cashiers, records officers, HR and a medical
  // director, with permissions varying by department and ward.
  //
  // Milestone 04 replaces this column with Role and Permission tables. The
  // middleware SHAPE stays as it is; only what it consults changes.
  role String @default("staff")   // 'owner' | 'staff'

  // Deactivate rather than delete. Staff leave, and their name has to stay
  // readable on every record they touched — a deleted user makes years of
  // clinical history say "unknown".
  //
  // getSession checks this, so deactivating signs someone out everywhere on
  // their next request rather than at the end of their session.
  isActive Boolean @default(true)

  sessions  Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  // The SHA-256 of the token, never the token itself. Someone who reads a
  // database dump cannot forge a session from it.
  id String @id

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Brute-force brake, in the database rather than in memory.
//
// SiteSilo kept this in a Map, and said so: fine for a single-instance CMS.
// Two things make that wrong here. It resets on restart, so an attacker gets a
// fresh five attempts every deploy. And it lives in one process, so it counts
// nothing once there is more than one.
//
// In the hospital's own database, so throttling is per hospital automatically —
// hammering one hospital's login does not lock an account at another that
// happens to share an email address.
model LoginThrottle {
  email       String   @id
  failures    Int      @default(0)
  windowStart DateTime @default(now())

  // Rows survive for emails that never succeed. Harmless and small, but
  // indexed so a periodic sweep is cheap when one is worth adding.
  @@index([windowStart])
}
