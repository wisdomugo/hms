node_modules/
docs/_generator/node_modules/
dist/
generated/

# Real secrets. .env.example IS committed; .env is not.
.env
.env.local
*.local

# Database dumps. A backup in git history is a full copy of a hospital's
# patient records, permanently, readable by anyone who can clone the repo —
# and deleting the file later does not remove it from history.
backups/
*.sql.gz
*.dump

# Uploaded files are the hospital's data, not source code. They never travel
# by git — see docs/WORKFLOW.md.
api/uploads/

# curl cookie jars from manual API testing. They hold a live session token —
# committing one would put a working key to a hospital's data in git history,
# where it stays even after the file is deleted.
cookies.txt
*.cookies
jar.txt

# Logs and editor noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# The working task list. Regenerate it with:
#   cd docs/_generator && node tasks.cjs
#
# Deliberately untracked: it changes on almost every working session, it is a
# scratchpad rather than a record, and a binary file that churns makes every
# diff useless. The GENERATOR is tracked, so the list is reproducible even
# though the document is not.
TASKS.docx
