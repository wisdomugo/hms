# ---------------------------------------------------------------
# Template for .env — copy this file to .env and fill in real values.
# This file IS committed to git. The real .env is NOT.
#
#   Windows:  copy .env.example .env
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Databases
#
# There are two kinds, and the difference matters.
#
#   THE CONTROL PLANE is one small database holding the routing table: which
#   hostname belongs to which hospital, and where that hospital's data lives.
#   The application reads it on every request.
#
#   A HOSPITAL DATABASE holds one hospital's records. There is one per hospital,
#   and the application never learns their connection strings from this file —
#   it reads them from the control plane.
#
# On a shared server the control plane has one row per hospital. On a hospital's
# own server it has exactly one row. Same code either way.
# ---------------------------------------------------------------

# The control plane. The API refuses to start without it, because without it
# there is no way to work out which hospital a request belongs to.
CONTROL_PLANE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/hms_control?schema=public"

# What the PRISMA CLI uses when nothing overrides it.
#
# The scripts in api/scripts/ set this per invocation — to the control plane for
# control migrations, to each hospital in turn for tenant migrations. The
# running application does not use it at all.
#
# Note: if your password contains @ # : / or ?, URL-encode it.
#   @ -> %40    # -> %23    : -> %3A    / -> %2F
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/hms_dev?schema=public"

# ---------------------------------------------------------------
# Tenant resolution
# ---------------------------------------------------------------

# Which hospital to use when the request's hostname matches none.
#
# IT IS A FALLBACK, NOT AN OVERRIDE. A hostname that matches a registered
# hospital always wins — so if 'localhost' is registered to one hospital, this
# setting will never fire while you browse localhost. Check which one actually
# resolved with:  curl localhost:3000/api/health   and read tenant.via.
#
# Two jobs, one setting:
#
#   In DEVELOPMENT, localhost is a single hostname, so this is what makes the
#   API usable at all.
#
#   On a HOSPITAL'S OWN SERVER there is exactly one hospital and the hostname
#   could be anything — their domain, an IP address, localhost during setup.
#   This says "whatever came in, it is this one".
#
# Leave it UNSET on a shared server serving several hospitals: there, an
# unrecognised hostname should be a 404, not a silent fallback into somebody
# else's records.
DEFAULT_TENANT=dev

# Connections per hospital in the pool.
#
# Prisma's default multiplied by fifty hospitals would ask Postgres for several
# hundred connections against a default max_connections of 100. Three is
# generous for one hospital's request volume. Put PgBouncer in front once this
# is past a dozen hospitals rather than raising it.
TENANT_POOL_MAX=3

# How long a hostname-to-hospital lookup is cached, in milliseconds.
# Resolution runs on every request, so it is cached; onboarding a hospital takes
# up to this long to be noticed by a running API.
TENANT_CACHE_MS=60000

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------

# Port the Express server listens on.
PORT=3000

# Node environment: development | production
#
# More than a label. The X-Tenant header, which lets one localhost act as
# several hospitals, is honoured ONLY when this is not "production". Setting
# this correctly on a server is what stops that header being a way to switch
# hospitals.
NODE_ENV=development

# Whether Express serves the built staff app itself.
#
# false in development: Vite serves it and proxies /api and /uploads back here.
#
# MUST BE true ON A SERVER. Without it the API answers but no app is served at
# all — you get JSON on /api and nothing anywhere else, which looks like a
# broken deployment rather than a missing setting.
#
# It serves app/dist, so the app must be built first:
#   cd app && npm run build
SERVE_STATIC=false

# ---------------------------------------------------------------
# Auth cookie
#
# Defaults suit localhost and same-origin deployment. Nothing below needs
# changing until the staff app lives somewhere other than the same origin
# as the API.
# ---------------------------------------------------------------

# How long a session lasts, in hours.
#
# SiteSilo used 7 DAYS, which is right for a CMS one person logs into from their
# own laptop. It is wrong for a ward computer three nurses share across a shift
# change. 12 hours covers a long shift; drop it if a hospital's policy is
# stricter.
SESSION_HOURS=12

# lax  — blocks cross-site POSTs. Correct for same-origin and for subdomains
#        of one domain.
# none — required only when the app and API are on different domains.
#        Also requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Send the cookie over HTTPS only. MUST be true in any real deployment;
# false here only because localhost is plain HTTP.
COOKIE_SECURE=false

# Only for subdomain deployments, e.g. app.example.com + api.example.com
# COOKIE_DOMAIN=.example.com

# Only when the staff app is served from a different origin. Setting this turns
# on CORS with credentials; leave unset for same-origin.
# APP_ORIGIN=https://app.example.com

# SETUP_TOKEN is gone as of milestone 03.
#
# The setup token is now per hospital, single-use, and lives in the control
# plane. One token here would be one token for the WHOLE SERVER, meaning
# whoever held it could claim the first account at any hospital not yet set
# up. onboard.mjs generates one per hospital and prints it once.

# ---------------------------------------------------------------
# File storage
# ---------------------------------------------------------------

# Where uploaded files are kept: local | s3
# "local" writes to api/uploads/ and serves it from /uploads.
#
# Fine on a VM with a persistent disk, which is the deployment target. Switch to
# s3 before deploying anywhere with an ephemeral filesystem, and before
# radiology arrives — module 09 changes the volume by an order of magnitude.
#
# See the KNOWN GAP comment in index.js: on a shared server, uploads are not yet
# separated per hospital. Milestone 05 closes that.
STORAGE_DRIVER=local

# Maximum upload size in bytes. 10 MB by default. Scanned referral letters and
# ID cards fit comfortably; raise it when module 09 lands.
MAX_UPLOAD_BYTES=10485760

# Set by deploy.sh so /health can report which commit is running.
# GIT_COMMIT=
