// HMS — the HOSPITAL schema.
//
// One database shaped like this per hospital. Nothing here has a tenant column,
// and that is the point: separation is the database boundary, not a WHERE
// clause someone has to remember.
//
// Migrations so far:
//   add_auth   User, Session, LoginThrottle          (milestone 03)
//   add_audit  AuditEvent                            (milestone 04)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// No `url` here on purpose. The connection string is supplied at runtime by the
// driver adapter, which is what makes one client per hospital possible.
datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  name         String?

  // PLACEHOLDER. Two string roles is not what a hospital needs — receptionists,
  // triage nurses, doctors, lab scientists, pharmacists, cashiers, records
  // officers, HR and a medical director, with permissions varying by department
  // and ward.
  //
  // Milestone 06 replaces this column with Role and Permission tables. The
  // middleware SHAPE stays as it is; only what it consults changes.
  role String @default("staff")   // 'owner' | 'staff'

  // Deactivate rather than delete. Staff leave, and their name has to stay
  // readable on every record they touched — a deleted user makes years of
  // clinical history say "unknown".
  //
  // getSession checks this, so deactivating signs someone out everywhere on
  // their next request rather than at the end of their session.
  isActive Boolean @default(true)

  sessions    Session[]
  auditEvents AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  // The SHA-256 of the token, never the token itself. Someone who reads a
  // database dump cannot forge a session from it.
  id String @id

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Brute-force brake, in the database rather than in memory.
//
// In memory it resets on every restart — an attacker gets a fresh five attempts
// per deploy — and counts nothing once there is more than one process. Being in
// the hospital's own database also makes it per-hospital for free.
model LoginThrottle {
  email       String   @id
  failures    Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// ---------------------------------------------------------------------------
// AUDIT
//
// Permissions decide who MAY act. This records who DID.
//
// It exists before the module it is for because it is the one thing that cannot
// be added retrospectively: permissions introduced later work from that day on,
// but a log introduced later has nothing to say about what came before it.
//
// APPEND ONLY. Nothing updates or deletes a row here. The application enforces
// that by having no route that could — see modules/audit/routes.js. Enforcing
// it in Postgres properly means a database role holding INSERT and SELECT but
// not UPDATE or DELETE on this table, and that should be set up before the
// pilot hospital goes live.
// ---------------------------------------------------------------------------
model AuditEvent {
  id Int @id @default(autoincrement())

  at DateTime @default(now())

  // Nullable, because not every event has a signed-in actor: a failed login has
  // none by definition, and neither does a scheduled job.
  //
  // SetNull rather than Cascade — deleting a user must never delete the record
  // of what they did. (Users are deactivated rather than deleted anyway, so
  // this is a second line of defence.)
  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // The actor's email AS IT WAS. A snapshot, not a convenience: staff change
  // their names and leave, and the log has to stay readable years later without
  // depending on a row that has moved on.
  actorEmail String?

  // What happened: '<area>.<verb>', from ACTIONS in lib/audit.js. Never typed
  // as a literal at a call site — a typo becomes an event no report ever finds.
  action String

  // What it happened to. entityId is a STRING because Patient ids are integers
  // and Tenant ids are cuids, and a log that can only reference one kind of id
  // stops being written the first time that is inconvenient.
  entity   String?
  entityId String?

  // 'ok' | 'failed' | 'denied'. A refused action is worth recording — often
  // more than a successful one.
  outcome String @default("ok")

  ip        String?
  userAgent String?

  // Identifiers and field NAMES only. NEVER field values, and never anything
  // clinical. The audit log is read by more people than the records it
  // describes, so copying detail into it quietly widens who can see that
  // detail — and an append-only table is one nobody can correct afterwards.
  meta Json?

  // at            — the log is read newest-first, always
  // actorId       — "what has this member of staff been doing"
  // entity+id     — "what has happened to this patient"  ← the investigation query
  // action        — "show me every merge this month"
  @@index([at])
  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
}
