# ---------------------------------------------------------------
# Template for .env — copy this file to .env and fill in real values.
# This file IS committed to git. The real .env is NOT.
#
#   Windows:  copy .env.example .env
# ---------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Note: if your password contains @ # : / or ?, URL-encode it.
#   @ -> %40    # -> %23    : -> %3A    / -> %2F
#
# STEP 2 CHANGES THE MEANING OF THIS.
# Once the tenant seam exists, a hospital's connection string comes from the
# control plane, not from here. This stays as the DEVELOPMENT default and the
# database the control plane itself lives in.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/hms_dev?schema=public"

# Step 2 adds:
# CONTROL_PLANE_URL="postgresql://postgres:...@localhost:5432/hms_control?schema=public"

# Port the Express server listens on.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Whether Express serves the built staff app itself.
#
# false in development: Vite serves it and proxies /api and /uploads back here.
#
# MUST BE true ON A SERVER. Without it the API answers but no app is served at
# all — you get JSON on /api and nothing anywhere else, which looks like a
# broken deployment rather than a missing setting.
#
# It serves app/dist, so the app must be built first:
#   cd app && npm run build
SERVE_STATIC=false

# ---------------------------------------------------------------
# Auth cookie
#
# Defaults suit localhost and same-origin deployment. Nothing below needs
# changing until the staff app lives somewhere other than the same origin
# as the API.
# ---------------------------------------------------------------

# How long a session lasts, in hours.
#
# SiteSilo used 7 DAYS, which is right for a CMS one person logs into from
# their own laptop. It is wrong for a ward computer three nurses share across
# a shift change. 12 hours covers a long shift; drop it further if the
# hospital's own policy is stricter.
SESSION_HOURS=12

# lax  — blocks cross-site POSTs. Correct for same-origin and for subdomains
#        of one domain.
# none — required only when the app and API are on different domains.
#        Also requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# Send the cookie over HTTPS only. MUST be true in any real deployment;
# false here only because localhost is plain HTTP.
COOKIE_SECURE=false

# Only for subdomain deployments, e.g. app.example.com + api.example.com
# COOKIE_DOMAIN=.example.com

# Only when the staff app is served from a different origin. Setting this
# turns on CORS with credentials; leave unset for same-origin.
# APP_ORIGIN=https://app.example.com

# One-time token required to create the first owner account after deployment.
# Generate a fresh one PER HOSPITAL:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SETUP_TOKEN=

# ---------------------------------------------------------------
# File storage
# ---------------------------------------------------------------

# Where uploaded files are kept: local | s3
# "local" writes to api/uploads/ and serves it from /uploads.
#
# Fine on a VM with a persistent disk, which is the deployment target. Switch
# to s3 before deploying anywhere with an ephemeral filesystem, and before
# radiology arrives — module 09 changes the volume by an order of magnitude.
STORAGE_DRIVER=local

# Maximum upload size in bytes. 10 MB by default. Scanned referral letters and
# ID cards fit comfortably; raise it when module 09 lands.
MAX_UPLOAD_BYTES=10485760

# Set by deploy.sh so /health can report which commit is running.
# GIT_COMMIT=
